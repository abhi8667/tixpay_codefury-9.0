# Money Coach (the chat screen) is the only feature that needs this.
# Every other screen works with no key at all — the coach just shows a banner
# explaining what's missing instead of crashing.
#
# Copy this file to `.env` in the same directory and put your key in.
# Expo inlines EXPO_PUBLIC_* vars at build time, so restart the dev server
# after changing it.
EXPO_PUBLIC_GEMINI_API_KEY=
